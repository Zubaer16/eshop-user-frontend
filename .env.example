# Public configuration only; never put secrets in NEXT_PUBLIC_ variables.
# One storefront: catalog, account and commerce content always use the Backend API.
# Bare backend origin; /v1 is added by the client. HTTPS is required in production.
NEXT_PUBLIC_ESHOP_API_URL=http://localhost:4000
# Legacy NEXT_PUBLIC_KOOKABURRA_API_URL remains a compatibility fallback.

# Same-origin session endpoint: exact public app origin (HTTPS in production).
ESHOP_APP_ORIGIN=http://localhost:3000
# Optional server-only origin for the same trusted Backend (no /v1 suffix).
# ESHOP_API_URL=http://localhost:4000

# Optional public Firebase browser app/VAPID configuration. Never service credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
